# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL - for production)
# DB_NAME=travel_ai
# DB_USER=postgres
# DB_PASSWORD=your-password
# DB_HOST=localhost
# DB_PORT=5432

# API Keys
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_PLACES_API_KEY=AIza...
GEOAPIFY_API_KEY=...
UNSPLASH_ACCESS_KEY=...
AMADEUS_CLIENT_ID=...
AMADEUS_CLIENT_SECRET=...
ORS_API_KEY=...

# Local POI Dataset
USE_LOCAL_POI_DATASET=1
LOCAL_POI_LANDMARK_QUOTA=10
LOCAL_POI_LANDMARK_MAX_PER_DAY=3
LOCAL_POI_MIN_RATING=4.0
LOCAL_POI_MIN_REVIEWS=50

# Email (for production)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-email@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# Michelin augmentation (optional: add Michelin restaurants via Google Places)
MICHELIN_AUGMENT_MIN_COUNT=6
MICHELIN_AUGMENT_MAX_CALLS=12

# Google Places caching TTL (days)
PLACE_QUERY_TTL_DAYS=14
PLACE_DETAILS_TTL_DAYS=14
